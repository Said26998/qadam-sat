{
  "appId": "io.github.said26998.qadamsat",
  "appName": "Qadam SAT",
  "webDir": "www",
  "server": {
    "url": "https://said26998.github.io/qadam-sat/",
    "errorPath": "offline.html"
  },
  "android": {
    "backgroundColor": "#F2F4FA"
  },
  "ios": {
    "backgroundColor": "#F2F4FA",
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#1F45C8",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace the email below with the teacher's Google email (lower case) before pasting into Firebase.
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['teacher-email@gmail.com'];
    }
    // One document per student, written only by that student.
    match /students/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isTeacher());
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if isTeacher();
    }
    // Official question bank: private. Only the teacher can add questions; only students the teacher allows can read them.
    match /bank/{id} {
      allow read: if isTeacher() || (request.auth != null && exists(/databases/$(database)/documents/access/$(request.auth.uid)));
      allow write: if isTeacher();
    }
    // One document per allowed student, written only by the teacher.
    match /access/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isTeacher());
      allow write: if isTeacher();
    }
  }
}
